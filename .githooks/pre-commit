#!/bin/sh
# Refuse to commit family data to this repository.
#
# .gitignore stops accidents; this stops deliberate ones too ("git add -f")
# and anything .gitignore misses. The repository is public, so a single
# committed database or CSV export would publish real families' names,
# addresses and phone numbers permanently -- rewriting history does not
# reliably un-publish what has already been fetched or indexed.
#
# Enable it once per clone:   git config core.hooksPath .githooks

blocked=$(git diff --cached --name-only |
  grep -iE '(^|/)instance/|\.sqlite[0-9]*$|\.db$|^\.env$|(^|/)\.env$|\.csv$|_backup|\.bak$')

if [ -n "$blocked" ]; then
  echo "BLOCKED: these files may contain family data and must not be committed:" >&2
  echo "$blocked" | sed 's/^/  /' >&2
  echo "" >&2
  echo "This repository is public. If a database or export is committed, the" >&2
  echo "families in it are published permanently." >&2
  echo "" >&2
  echo "Remove them from the commit with:" >&2
  echo "  git restore --staged <file>" >&2
  echo "" >&2
  echo "If you are certain a file is safe, commit once with --no-verify." >&2
  exit 1
fi
