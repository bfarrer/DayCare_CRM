# Copy to .env and edit. Never commit the real .env.

# Long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-before-real-use

# Local prototype (default). Path is relative to the instance/ folder.
DATABASE_URL=sqlite:///daycare_crm.sqlite3

# Shared Postgres — swap the line above for this when the team goes multi-user:
# DATABASE_URL=postgresql+psycopg://crm_user:password@db-host:5432/daycare_crm

# Set to 1 only while developing locally.
FLASK_DEBUG=0
